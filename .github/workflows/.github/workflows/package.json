{
  "name": "founders-and-friends",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Job boards for the OpCo and PropTech hubs, fed by a scraper into a static JSON feed.",
  "scripts": {
    "detect": "node scripts/detect-ats.mjs",
    "detect:dry": "node scripts/detect-ats.mjs --dry",
    "scrape": "node run.js",
    "scrape:opco": "node run.js --hub=opco",
    "scrape:proptech": "node run.js --hub=proptech",
    "scrape:dry": "node run.js --dry",
    "serve": "npx --yes serve public"
  },
  "engines": { "node": ">=20" }
}
